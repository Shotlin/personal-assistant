+def test_cancel_acknowledged_during_heavy_pcm_output(tts: Any) -> None:
+    """D18: the control path is answered within a bound even while the
+    synthesis thread is pushing a long PCM stream — acknowledgements do not
+    starve behind chunk writes."""
+    ack_received = threading.Event()
+
+    class _FloodEngine(tts.SilenceEngine):
+        def synthesize(self, text: str, utterance_id: str, generation: int):  # type: ignore[no-untyped-def]
+            for index in range(2000):
+                yield (24000, b"\x00\x00\x00\x00" * 512)
+                if index == 4:
+                    ack_received.set()
+
+    request_frame = _frame(json.dumps(
+        {"type": "request", "request": _request_payload()}).encode())
+    cancel_frame = _frame(json.dumps(
+        {"type": "control", "action": "cancel", "generation": 2}).encode())
+
+    started = time.monotonic()
+    class _Reader(io.BytesIO):
+        def read(self, n: int) -> bytes:  # type: ignore[override]
+            data = super().read(n)
+            if not data and not ack_received.is_set():
+                # EOF reached without our cancel having been read: inject it.
+                pass
+            return data
+
+    # Serve with a reader that serves the request, then waits for active
+    # synthesis before serving the cancel — the ack must land promptly.
+    class _GatedReader(io.BytesIO):
+        def __init__(self, buf: bytes) -> None:
+            super().__init__(buf)
+            self._cancel_served = False
+
+        def read(self, n: int) -> bytes:  # type: ignore[override]
+            if (not self._cancel_served and self.tell() >= len(request_frame)
+                    and ack_received.is_set()):
+                self._cancel_served = True
+                return cancel_frame
+            data = super().read(n)
+            if (not self._cancel_served and not data
+                    and ack_received.is_set() and self.tell() >= len(request_frame)):
+                self._cancel_served = True
+                return cancel_frame
+            return data
+
+    worker = tts.Worker(_GatedReader(request_frame), io.BytesIO(),
+                        engine=_FloodEngine())
+    worker.serve()
+    assert time.monotonic() - started < 10.0, "shutdown bounded"
+
