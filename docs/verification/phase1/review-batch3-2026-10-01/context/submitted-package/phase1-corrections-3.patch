+def test_shutdown_with_full_queue_and_gated_engine_is_bounded(tts: Any) -> None:
+    """D18 regression: with ALL pending slots full and the engine gated
+    (never yields), shutdown must still reach the bounded join and return —
+    the batch-2 sentinel put blocked forever here."""
+    release = threading.Event()
