+    ], engine=_ExplodingCancel())
+    assert any(e["event"] == "cancelled" and e.get("generation") == 3 for e in events), (
+        "the cancelled acknowledgement is emitted despite the engine crash")
+    assert not any(e["event"] == "error" and e.get("message", "").startswith("worker error")
+                   for e in events), "the worker did not die from the engine cancel"
