+    settings = _StubSettings()
+    authority = MissionAuthority(store)
+    evidence = EvidenceStore(tmp_path / "ev", store)
+    executor = VeloExecutor(settings, get_runtime=get_runtime, authority=authority,
+                            evidence=evidence, store=store)
