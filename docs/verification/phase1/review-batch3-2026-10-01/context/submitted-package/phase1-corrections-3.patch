+
+        def synthesize(self, text: str, utterance_id: str, generation: int):  # type: ignore[no-untyped-def]
+            release.wait(timeout=5.0)
+            return iter(())
+
+    # Fill the FIFO: one in synthesis, MAX_PENDING_REQUESTS-1 queued.
+    request_frames = b"".join(_frame(json.dumps(
+        {"type": "request",
+         "request": _request_payload(request_id=f"r{i}", utterance_id=f"u{i}",
+                                     message_id=f"m{i}")}).encode())
+        for i in range(tts.Worker.MAX_PENDING_REQUESTS))
+    shutdown_frame = _frame(json.dumps(
