APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8787
LOG_LEVEL=INFO

AGENT_GATEWAY_API_KEY=change-me
ASSISTANT_MODEL_ID=personal-assistant-v1
ASSISTANT_ID=personal-assistant

MODEL_PROVIDER=openrouter
MODEL_NAME=openrouter/auto
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=2000
MODEL_REASONING_EFFORT=low

OPENROUTER_API_KEY=
OPENAI_API_KEY=

DATABASE_URL=postgresql://assistant:assistant@127.0.0.1:5433/assistant

# Sani local persistence (Sani master doc sections 2-5). Default "postgres"
# keeps the legacy gateway behavior; "sqlite" runs the Deep Agent
# checkpointer + long-term memory AND run metadata on the embedded sani.db
# under SANI_DATA_DIR (no Docker/PostgreSQL; the secret-screening policy is
# unchanged).
# MEMORY_BACKEND=sqlite
# SANI_DATA_DIR=/absolute/path/to/Sani AppData

CUA_ENABLED=true
CUA_COMMAND=cua-driver
CUA_PERMISSION_MODE=bounded
CUA_CAPABILITY_MANIFEST_PATH=/absolute/path/to/personal-assistant/config/cua-capabilities.yaml
CUA_EXISTING_PROFILE_GRANT=false
CUA_ARTIFACT_DIR=var/artifacts

# Feature flags (WP8 rollback levers; see README "Feature flags & rollback").
# COMPACT_PLANNER_ENABLED=false sends every non-exact turn to the general
# agent exactly as before WP6 (planner rollout is currently OFF by default).
COMPACT_PLANNER_ENABLED=false
# ACTIVE_CURSOR_PERSISTENCE_ENABLED=false disables cursor sessions entirely:
# runs execute without a visible agent cursor and the driver is never
# contacted for sessions.
ACTIVE_CURSOR_PERSISTENCE_ENABLED=true
# STATUS_EVENTS_ENABLED=false removes the deterministic [working]/[waiting]
# SSE progress lines (WP3 7.4); interface output only, never model history.
STATUS_EVENTS_ENABLED=true

# Velo controller (master plan sections 4-5). Route A commands resolve and
# execute locally with no model call; Route B interpretation needs the JEV
# structured decision service. Disabled means Route B reports "decision
# service unavailable" honestly and never substitutes another model.
VELO_JEV_ENABLED=false
# VELO_PROVIDER=openrouter        # or "typesafe"
# TYPESAFE_API_KEY=
# VELO_JEV_MODEL=jev-latest
# Only a System One-compatible root (Noul/Choice over /v1/systemone).
# VELO_TYPESAFE_BASE_URL=
# VELO_MAX_DECISION_SECONDS=30
# Deadline for one local Velo command (Route A/B), far below the run wall clock.
# VELO_COMMAND_DEADLINE_SECONDS=90

