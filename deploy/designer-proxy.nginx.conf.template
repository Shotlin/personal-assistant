# Same-origin reverse proxy for the Agent Designer integration (nginx:alpine
# template; ${VARS} are substituted from the container environment at start).
#
# - /designer/*  -> gateway (127.0.0.1:8787 on the host)  [Designer SPA + API]
# - /*           -> open-webui:8080                        [Open WebUI]
#
# The proxy is the ONLY component on port 3000: the user stays on the Open
# WebUI origin, /designer/ becomes a real same-origin route (fixes the 404
# and refresh problem), and the gateway's SSO verifies the forwarded Open
# WebUI session server-side.
#
# The X-Designer-Proxy-Key header is the shared secret that tells the
# gateway this request came through the trusted proxy (SSO Mode C). It is
# set by nginx from the environment and is never exposed to any browser
# surface; a client cannot reach the gateway as this origin.

# WebSocket upgrade mapping (http context; conf.d files are http-level).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # ---------------------------------------------------------------
    # Agent Designer: SPA assets, API (incl. SSE), shell.js
    # ---------------------------------------------------------------
    location /designer/ {
        proxy_pass http://host.docker.internal:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Designer-Proxy-Key "${DESIGNER_PROXY_KEY}";
        # SSE: never buffer the run-event stream.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_set_header Connection "";
    }

    # ---------------------------------------------------------------
    # Open WebUI (everything else), with the Agent Designer shell
    # integration injected into served HTML pages.
    # ---------------------------------------------------------------
    location / {
        proxy_pass http://open-webui:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket support (Open WebUI realtime).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Inject the shell integration script into Open WebUI pages.
        # sub_filter needs the upstream body uncompressed.
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<script src="/designer/shell.js" defer></script></head>';
        sub_filter_once on;
        sub_filter_types text/html;
    }
}
