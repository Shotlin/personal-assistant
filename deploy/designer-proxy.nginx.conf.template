# Same-origin reverse proxy for the Agent Designer integration (nginx:alpine
# template; ${VARS} are substituted from the container environment at start).
#
# Routing on :3000:
#   /designer/assets/*, /designer/shell.js, /designer/api/*,
#   /designer/index.html, /designer/favicon.svg, /designer/icons.svg
#       -> gateway (127.0.0.1:8787)  [Designer app assets + API + SSE]
#   /designer, /designer/, anything else under /designer/
#       -> open-webui                [Open WebUI shell page + shell.js]
#   /*           -> open-webui
#
# The Open WebUI shell page is what the user sees at /designer/: their
# sidebar and theme stay, the shell script hides the main pane and mounts
# the Designer React app inside it (no iframe, no port hop, no second
# login -- the gateway verifies the forwarded Open WebUI session
# server-side). The standalone full-page Designer remains at :8787/designer/.

# WebSocket upgrade mapping (http context; conf.d files are http-level).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # ----- Designer static assets (built SPA bundle) -----
    location /designer/assets/ {
        proxy_pass http://host.docker.internal:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Designer-Proxy-Key "${DESIGNER_PROXY_KEY}";
    }

    # shell.js + designer public files (favicon/icons)
    location = /designer/shell.js {
        proxy_pass http://host.docker.internal:8787;
        proxy_set_header Host $host;
    }
    location ~* ^/designer/(favicon\.svg|icons\.svg)$ {
        proxy_pass http://host.docker.internal:8787;
        proxy_set_header Host $host;
    }

    # The designer's own index: used by shell.js to discover the hashed
    # asset URLs (and as the standalone document on :8787).
    location = /designer/index.html {
        proxy_pass http://host.docker.internal:8787;
        proxy_set_header Host $host;
    }

    # ----- Designer API (never intercepted by the SPA fallback) -----
    location /designer/api/ {
        proxy_pass http://host.docker.internal:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Designer-Proxy-Key "${DESIGNER_PROXY_KEY}";
        # SSE: never buffer the run-event stream.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_set_header Connection "";
    }

    # ----- Open WebUI shell (everything else, incl. /designer/ docs) --
    location / {
        proxy_pass http://open-webui:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket support (Open WebUI realtime).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Inject the shell integration script into Open WebUI pages.
        # sub_filter needs the upstream body uncompressed.
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<script src="/designer/shell.js" defer></script></head>';
        sub_filter_once on;
        sub_filter_types text/html;
    }
}
