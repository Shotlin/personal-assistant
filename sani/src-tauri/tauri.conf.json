{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sani",
  "version": "0.1.0",
  "identifier": "app.sani.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "python/sani_stt.py": "python/sani_stt.py",
      "../../config/cua-capabilities.yaml": "config/cua-capabilities.yaml",
      "../../src/assistant/skills": "skills",
      "release-manifest.json": "release-manifest.json",
      "binaries/sani-core-runtime": "sani-core-runtime",
      "binaries/CuaDriver.app": "CuaDriver.app"
    },
    "externalBin": ["binaries/sani-stt"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
